{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2021", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "jsxImportSource": "preact",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": []
  },
  "include": ["studio/src/**/*.ts", "studio/src/**/*.tsx", "src/shared/**/*.ts", "src/ui/api/*.ts", "src/ui/imageops.ts", "src/ui/clipboard.ts"]
}

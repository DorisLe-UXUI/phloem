# Port to listen on
PORT=8787
# Public URL of this relay (used for OAuth callbacks). Example: https://relay.yourdomain.com
PUBLIC_URL=http://localhost:8787
# Optional shared secret. If set, the plugin must send it as X-Phloem-Token (Settings → Relay token).
RELAY_TOKEN=
# OAuth (optional). Register apps at:
#   Mailchimp: https://admin.mailchimp.com/account/oauth2/   redirect = {PUBLIC_URL}/oauth/callback/mailchimp
#   Klaviyo:   https://www.klaviyo.com/manage-apps           redirect = {PUBLIC_URL}/oauth/callback/klaviyo
MAILCHIMP_CLIENT_ID=
MAILCHIMP_CLIENT_SECRET=
KLAVIYO_CLIENT_ID=
KLAVIYO_CLIENT_SECRET=
KLAVIYO_SCOPES=accounts:read campaigns:read campaigns:write templates:read templates:write images:read images:write lists:read
# AI (optional): lets Phloem Studio users call Claude through this relay without pasting their own key.
ANTHROPIC_API_KEY=
